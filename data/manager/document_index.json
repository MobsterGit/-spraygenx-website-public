  "description": "Master proposal and invoice index for Spray GenX Manager. This file is a sortable/searchable catalog, not the source document itself.",
  "rules": {
    "active_proposal_statuses": ["draft", "needs_revision", "sent", "pending", "accepted"],
    "inactive_proposal_statuses": ["converted_to_invoice", "declined", "expired", "archived"],
    "active_invoice_statuses": ["draft", "sent", "partial", "unpaid", "overdue"],
    "inactive_invoice_statuses": ["paid", "void", "archived"],
    "active_window_target": 20,
    "history_sort_default": "date_desc",
    "safe_save_required": true,
    "backup_before_replace": true
  },
  "backup": {
    "strategy": "safe-write",
    "before_each_save": true,
    "daily_snapshot": true,
    "full_export": true,
    "folders": {
      "versioned_backups": "Backups/YYYY/MM/",
      "daily_snapshots": "Backups/Daily/",
      "full_exports": "Backups/Exports/"
    }
  },
